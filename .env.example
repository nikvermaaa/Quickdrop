# Server Configuration
PORT=8000

# Database Configuration (PostgreSQL in Docker Compose, SQLite for local fallback)
DATABASE_URL=postgresql+asyncpg://quickdrop:quickdrop@postgres:5432/quickdrop_db

# External Services
PAYSWIFT_BASE_URL=http://payswift:8081

# LLM Configuration
# Choose: 'gemini', 'groq', or 'offline' (default is 'offline' for 100% deterministic local evals)
LLM_PROVIDER=gemini

# Google Gemini API Key & Model
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Groq API Key & Model
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Telegram Bot Configuration
# Obtain token from @BotFather on Telegram (optional, leave empty to disable)
TELEGRAM_BOT_TOKEN=
# Inactivity session timeout in seconds (default: 240 seconds = 4 minutes)
TELEGRAM_SESSION_TIMEOUT_SECONDS=240
